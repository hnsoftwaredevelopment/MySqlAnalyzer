<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:extensions="clr-namespace:MySqlAnalyzer.Extensions">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/MySqlAnalyzer;component/Resources/Icons/Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- BackGroundColours for tabs -->
    <SolidColorBrush x:Key="TableTabBackground" Color="#D6DFF9"/>
    <SolidColorBrush x:Key="ViewTabBackground" Color="#FAE8C8"/>
    <SolidColorBrush x:Key="ColumnsTabBackground" Color="#D6DFF9"/>
    <SolidColorBrush x:Key="IndexesTabBackground" Color="#D2FFD2"/>
    <SolidColorBrush x:Key="SqlTabBackground" Color="#EC9999"/>
    <SolidColorBrush x:Key="ForeignKeyTabBackground" Color="#FED5AF"/>

    <!-- Default Style for all tabs -->
    <Style TargetType="TabItem">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="DarkBlue"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4,4,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Generic Style that uses the attached properties -->
    <Style x:Key="IconTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=(extensions:TabItemExtensions.TabIcon)}"
                               Width="16"
                               Height="16"
                               Margin="0,0,5,0"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=(extensions:TabItemExtensions.TabText)}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Specific style for Table tab -->
    <Style x:Key="TableTabStyle" TargetType="TabItem" BasedOn="{StaticResource IconTabItemStyle}">
        <Setter Property="Background" Value="{StaticResource TableTabBackground}"/>
        <Setter Property="extensions:TabItemExtensions.TabIcon" Value="{StaticResource TableIcon}"/>
        <Setter Property="extensions:TabItemExtensions.TabText" Value="Tables"/>
    </Style>

    <!-- Specific style for View tab -->
    <Style x:Key="ViewTabStyle" TargetType="TabItem" BasedOn="{StaticResource IconTabItemStyle}">
        <Setter Property="Background" Value="{StaticResource ViewTabBackground}"/>
        <Setter Property="extensions:TabItemExtensions.TabIcon" Value="{StaticResource ViewIcon}"/>
        <Setter Property="extensions:TabItemExtensions.TabText" Value="Views"/>
    </Style>


    <!-- Specific style for Columns tab -->
    <Style x:Key="ColumnsTabStyle" TargetType="TabItem" BasedOn="{StaticResource IconTabItemStyle}">
        <Setter Property="Background" Value="{StaticResource ColumnsTabBackground}"/>
        <Setter Property="extensions:TabItemExtensions.TabIcon" Value="{StaticResource ColumnIcon}"/>
        <Setter Property="extensions:TabItemExtensions.TabText" Value="Columns"/>
    </Style>

    <!-- Specific style for Indexes tab -->
    <Style x:Key="IndexesTabStyle" TargetType="TabItem" BasedOn="{StaticResource IconTabItemStyle}">
        <Setter Property="Background" Value="{StaticResource ForeignKeyTabBackground}"/>
        <Setter Property="extensions:TabItemExtensions.TabIcon" Value="{StaticResource ForeignKeyIcon}"/>
        <Setter Property="extensions:TabItemExtensions.TabText" Value="Indexes"/>
    </Style>

    <!-- Specific style for Foreign Keys tab -->
    <Style x:Key="ForeignKeyTabStyle" TargetType="TabItem" BasedOn="{StaticResource IconTabItemStyle}">
        <Setter Property="Background" Value="{StaticResource IndexesTabBackground}"/>
        <Setter Property="extensions:TabItemExtensions.TabIcon" Value="{StaticResource IndexIcon}"/>
        <Setter Property="extensions:TabItemExtensions.TabText" Value="Foreign Keys"/>
    </Style>


    <!-- Specific style for Sql tab -->
    <Style x:Key="SqlTabStyle" TargetType="TabItem" BasedOn="{StaticResource IconTabItemStyle}">
        <Setter Property="Background" Value="{StaticResource SqlTabBackground}"/>
        <Setter Property="extensions:TabItemExtensions.TabIcon" Value="{StaticResource SqlIcon}"/>
        <Setter Property="extensions:TabItemExtensions.TabText" Value="SQL"/>
    </Style>

</ResourceDictionary>