<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:MySqlAnalyzer.Converters"
	xmlns:helpers="clr-namespace:MySqlAnalyzer.Helpers"
	xmlns:local="clr-namespace:MySqlAnalyzer"
	xmlns:local1="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
	xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
	>

	<!--#region Global Style for SfDataGrid-->
	<Style x:Key="DefaultDataGrid" TargetType="{x:Type syncfusion:SfDataGrid}">
		<Setter Property="AllowDeleting" Value="False" />
		<Setter Property="AllowEditing" Value="False" />
		<Setter Property="AllowFiltering" Value="True" />
		<Setter Property="AllowResizingColumns" Value="True" />
		<Setter Property="AllowTriStateSorting" Value="True" />
		<Setter Property="AutoGenerateColumns" Value="False" />
		<Setter Property="ColumnSizer" Value="Star" />
		<Setter Property="FilterRowPosition" Value="Top" />
		<Setter Property="Margin" Value="3,5" />
		<Setter Property="SelectionMode" Value="Extended" />
		<Setter Property="ShowSortNumbers" Value="True" />
		<Setter Property="SortClickAction" Value="DoubleClick" />
	</Style>
	<!--#endregion-->

	<!--#endregion-->
</ResourceDictionary>