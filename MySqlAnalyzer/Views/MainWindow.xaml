<Window x:Class="MySqlAnalyzer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MySqlAnalyzer"
        xmlns:vm="clr-namespace:MySqlAnalyzer.ViewModels"
        xmlns:models="clr-namespace:MySqlAnalyzer.Models"
        xmlns:converters="clr-namespace:MySqlAnalyzer.Converters"
        Title="MySQL Database Analyzer"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Icons/Icons.xaml" />
                <ResourceDictionary Source="/Resources/Styles/TabControlStyle.xaml" />
                <ResourceDictionary Source="/Resources/Styles/DataGridStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
            <converters:IndexColumnsConverter x:Key="IndexColumnsConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

            <!-- Simple Style for buttons -->
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="MinWidth" Value="80"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF007ACC" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📊" FontSize="24" Margin="0,0,10,0"/>
                <TextBlock Text="MySQL Database Analyzer"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Database Selection -->
            <GroupBox Grid.Row="0" Header="Database Selection" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Select Database:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,5"/>

                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding AvailableDatabases}"
                              SelectedItem="{Binding SelectedDatabase, Mode=TwoWay}"
                              Margin="0,0,10,5"
                              VerticalContentAlignment="Center">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>

                    <!-- Load Button -->
                    <Button Grid.Row="0" Grid.Column="2"
                            Content="Load"
                            Command="{Binding LoadDatabaseCommand}"
                            Style="{StaticResource ActionButtonStyle}"/>

                    <!-- Refresh Button -->
                    <Button Grid.Row="0" Grid.Column="3"
                            Content="Refresh"
                            Command="{Binding RefreshDatabasesCommand}"
                            Style="{StaticResource ActionButtonStyle}"/>

                    <!-- Loading indicator -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                Orientation="Horizontal"
                                Margin="0,5,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <ProgressBar Width="200" Height="10" IsIndeterminate="True"/>
                        <TextBlock Text="Loading..." Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Database Info (shown when database is loaded) -->
            <GroupBox Grid.Row="1" Header="Database Information" Margin="0,0,0,10">
                <GroupBox.Style>
                    <Style TargetType="GroupBox">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDatabase}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GroupBox.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Database:" FontWeight="Bold" Margin="0,0,5,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Database.Name}" Margin="0,0,10,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Contents:" FontWeight="Bold" Margin="0,0,5,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DatabaseSummary}" Margin="0,0,10,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Collation:" FontWeight="Bold" Margin="0,0,5,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Database.DefaultCollation}"/>
                </Grid>
            </GroupBox>

            <!-- Object Lists and Details -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Navigation -->
                <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Database Objects" FontWeight="Bold" Margin="10,10,10,5"/>

                        <TabControl Grid.Row="1" BorderThickness="0">
                            <TabItem Style="{DynamicResource TableTabStyle}" Header="Tables">
                                <ListBox ItemsSource="{Binding Database.Tables}"
                                         SelectedItem="{Binding SelectedTable}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <Image Source="{StaticResource TableIcon}" Width="16" Height="16" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>

                            <TabItem Style="{DynamicResource ViewTabStyle}"  Header="Views">
                                <ListBox ItemsSource="{Binding Database.Views}"
                                         SelectedItem="{Binding SelectedView}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <Image Source="{StaticResource ViewIcon}" Width="16" Height="16" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>

                <!-- GridSplitter -->
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

                <!-- Right Panel: Details -->
                <Border Grid.Column="2" Padding="10">
                    <ContentControl Content="{Binding SelectedObject}">
                        <ContentControl.Resources>
                            <!-- Table Details Template -->
                            <DataTemplate DataType="{x:Type models:TableModel}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Table Header -->
                                        <Border Background="#F0F0F0" Padding="10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Comment}" FontStyle="Italic" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Table Properties Grid -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Engine:" FontWeight="Bold" Margin="0,0,5,5"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Engine}" Margin="0,0,10,5"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Collation:" FontWeight="Bold" Margin="0,0,5,5"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Collation}" Margin="0,0,10,5"/>

                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Size:" FontWeight="Bold" Margin="0,0,5,5"/>
                                            <TextBlock Grid.Row="1" Grid.Column="3">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}">
                                                        <Binding Path="DataLength" Converter="{StaticResource BytesToSizeConverter}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Created:" FontWeight="Bold" Margin="0,0,5,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Created, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Updated:" FontWeight="Bold" Margin="0,0,5,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Updated, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Margin="0,0,0,0"/>
                                        </Grid>

                                        <!--#region Tab Control for different sections of Tables -->
                                        <TabControl>
                                            <!--#region Columns Tab -->
                                            <TabItem Style="{StaticResource ColumnsTabStyle}" Header="Columns">
                                                <DataGrid ItemsSource="{Binding Columns}"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True"
                                                          HeadersVisibility="Column"
                                                          CanUserSortColumns="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>

                                                        <DataGridTextColumn Header="Data Type" Binding="{Binding ColumnType}" Width="120"/>

                                                        <DataGridCheckBoxColumn Header="Nullable" Binding="{Binding IsNullable}" Width="70"/>

                                                        <DataGridCheckBoxColumn Header="Auto Inc" Binding="{Binding IsAutoIncrement, Mode=OneWay}" Width="70" IsReadOnly="True">
                                                            <DataGridCheckBoxColumn.CellStyle>
                                                                <Style TargetType="DataGridCell">
                                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                </Style>
                                                            </DataGridCheckBoxColumn.CellStyle>
                                                        </DataGridCheckBoxColumn>

                                                        <DataGridTemplateColumn Header="Key" Width="60">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                        <!-- Primary Key -->
                                                                        <Image Source="{StaticResource PrimaryKeyIcon}" Height="14" Margin="1">
                                                                            <Image.Visibility>
                                                                                <Binding Path="ColumnKey">
                                                                                    <Binding.Converter>
                                                                                        <converters:StringToVisibilityConverter/>
                                                                                    </Binding.Converter>
                                                                                    <Binding.ConverterParameter>PRI</Binding.ConverterParameter>
                                                                                </Binding>
                                                                            </Image.Visibility>
                                                                        </Image>

                                                                        <!-- Unique Key -->
                                                                        <Image Source="{StaticResource UniqueKeyIcon}" Height="14" Margin="1">
                                                                            <Image.Visibility>
                                                                                <Binding Path="ColumnKey">
                                                                                    <Binding.Converter>
                                                                                        <converters:StringToVisibilityConverter/>
                                                                                    </Binding.Converter>
                                                                                    <Binding.ConverterParameter>UNI</Binding.ConverterParameter>
                                                                                </Binding>
                                                                            </Image.Visibility>
                                                                        </Image>

                                                                        <!-- Foreign Key -->
                                                                        <Image Source="{StaticResource ForeignKeyIcon}" Height="14" Margin="1">
                                                                            <Image.Visibility>
                                                                                <Binding Path="IsForeignKey">
                                                                                    <Binding.Converter>
                                                                                        <converters:BooleanToVisibilityConverter/>
                                                                                    </Binding.Converter>
                                                                                </Binding>
                                                                            </Image.Visibility>
                                                                        </Image>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>

                                                        <DataGridTextColumn Header="Default" Binding="{Binding DefaultValue}" Width="100"/>

                                                        <DataGridTextColumn Header="Extra" Binding="{Binding Extra}" Width="100"/>

                                                        <DataGridTextColumn Header="Charset" Binding="{Binding CharacterSet}" Width="80"/>

                                                        <DataGridTextColumn Header="Collation" Binding="{Binding Collation}" Width="100"/>

                                                        <DataGridTextColumn Header="Expression" Binding="{Binding GenerationExpression}" Width="150">
                                                            <DataGridTextColumn.CellStyle>
                                                                <Style TargetType="DataGridCell">
                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                    <Setter Property="Foreground" Value="Gray" />
                                                                </Style>
                                                            </DataGridTextColumn.CellStyle>
                                                        </DataGridTextColumn>

                                                        <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </TabItem>
                                            <!--#endregion-->

                                            <!--#region Indexes Tab -->
                                            <TabItem Style="{StaticResource IndexesTabStyle}" Header="Indexes">
                                                <DataGrid ItemsSource="{Binding Indexes}"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                                                        <DataGridCheckBoxColumn Header="Primary" Binding="{Binding IsPrimary}" Width="60"/>
                                                        <DataGridCheckBoxColumn Header="Unique" Binding="{Binding IsUnique}" Width="60"/>
                                                        <DataGridTextColumn Header="Type" Binding="{Binding IndexType}" Width="80"/>
                                                        <DataGridTextColumn Header="Columns" Width="200">
                                                            <DataGridTextColumn.Binding>
                                                                <MultiBinding StringFormat="{}{0}">
                                                                    <Binding Path="Columns">
                                                                        <Binding.Converter>
                                                                            <converters:IndexColumnsConverter/>
                                                                        </Binding.Converter>
                                                                    </Binding>
                                                                </MultiBinding>
                                                            </DataGridTextColumn.Binding>
                                                        </DataGridTextColumn>
                                                        <DataGridTextColumn Header="Cardinality" Binding="{Binding Cardinality, StringFormat='{}{0:N0}'}" Width="80"/>
                                                        <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </TabItem>
                                            <!--#endregion-->

                                            <!--#region Foreign Keys Tab -->
                                            <TabItem Style="{StaticResource ForeignKeyTabStyle}" Header="Foreign Keys">
                                                <DataGrid ItemsSource="{Binding ForeignKeys}"
                                                          AutoGenerateColumns="False"
                                                          IsReadOnly="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                                                        <DataGridTextColumn Header="Referenced Table" Binding="{Binding ReferencedTable}" Width="150"/>
                                                        <DataGridTextColumn Header="Update Rule" Binding="{Binding UpdateRule}" Width="100"/>
                                                        <DataGridTextColumn Header="Delete Rule" Binding="{Binding DeleteRule}" Width="100"/>
                                                        <DataGridTextColumn Header="Columns Mapping" Width="*">
                                                            <DataGridTextColumn.Binding>
                                                                <MultiBinding StringFormat="{}{0} → {1}">
                                                                    <Binding Path="ColumnMappings">
                                                                        <Binding.Converter>
                                                                            <converters:ForeignKeyColumnsConverter/>
                                                                        </Binding.Converter>
                                                                    </Binding>
                                                                </MultiBinding>
                                                            </DataGridTextColumn.Binding>
                                                        </DataGridTextColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </TabItem>
                                            <!--#endregion-->

                                            <!--#region SQL Tab -->
                                            <TabItem Style="{StaticResource SqlTabStyle}" Header="SQL">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Top"
                                                            Content="Copy to Clipboard"
                                                            Margin="0,0,0,5"
                                                            Click="CopySqlToClipboard_Click"/>

                                                    <TextBox x:Name="SqlTextBox"
                                                             Text="{Binding CreateScript, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             FontFamily="Consolas"
                                                             FontSize="11"
                                                             TextWrapping="NoWrap"
                                                             VerticalScrollBarVisibility="Auto"
                                                             HorizontalScrollBarVisibility="Auto"/>
                                                </DockPanel>
                                            </TabItem>
                                            <!--#endregion-->
                                        </TabControl>
                                        <!--#endregion-->
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>

                            <!-- View Details Template -->
                            <DataTemplate DataType="{x:Type models:ViewModel}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Image Source="{StaticResource ViewIcon}" Width="24" Height="24" Margin="0,0,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                                                <TextBlock Text="(View)" FontStyle="Italic" Foreground="Gray"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Text="Definition:" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding Definition}"
                                                 IsReadOnly="True"
                                                 FontFamily="Consolas"
                                                 FontSize="11"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Height="200"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Content="Export"
                        Command="{Binding ExportCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="5,0"
                        Padding="10,3"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>