<Page x:Class="MySqlAnalyzer.Views.DatabaseOverviewView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:converters="clr-namespace:MySqlAnalyzer.Converters"
      xmlns:local="clr-namespace:MySqlAnalyzer.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Database Overview">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Icons/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BytesToSizeConverter x:Key="BytesToSizeConverter"/>
            <converters:IndexColumnsConverter x:Key="IndexColumnsConverter"/>

            <!-- Simple Style for buttons -->
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="MinWidth" Value="80"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Database Header -->
            <Border Background="#007ACC" Padding="15" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="{Binding Database.Name}" 
                               Foreground="White" 
                               FontSize="24" 
                               FontWeight="Bold"/>
                    <TextBlock Text="Database Overview" 
                               Foreground="#CCFFFFFF" 
                               FontSize="14"/>
                </StackPanel>
            </Border>

            <!-- Database Info -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Character Set:" FontWeight="Bold" Margin="0,0,5,10"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Database.DefaultCharacterSet}" Margin="0,0,20,10"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Collation:" FontWeight="Bold" Margin="0,0,5,10"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Database.DefaultCollation}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Created:" FontWeight="Bold" Margin="0,0,5,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Database.Created, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Margin="0,0,20,0"/>
            </Grid>

            <!-- Statistics -->
            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Margin="0,20,0,0" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Database.TotalTables}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tables" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Database.TotalViews}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Views" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Database.TotalStoredProcedures}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Procedures" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Database.TotalFunctions}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Functions" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tables List -->
            <TextBlock Text="Tables" FontSize="18" FontWeight="Bold" Margin="0,30,0,10"/>
            <ItemsControl ItemsSource="{Binding Database.Tables}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,5" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Comment}" FontStyle="Italic" Foreground="Gray"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding TableRows, StringFormat='{}{0:N0} rows'}" Margin="0,0,10,0"/>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}">
                                                <Binding Path="DataLength" Converter="{StaticResource BytesToSizeConverter}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
