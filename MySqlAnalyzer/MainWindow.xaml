<Window
	x:Class="MySqlAnalyzer.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="clr-namespace:MySqlAnalyzer.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:MySqlAnalyzer"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
	xmlns:viewmodels="clr-namespace:MySqlAnalyzer.ViewModel"
	Title="MySql Database Analyzer"
	Width="800"
	Height="450"
	d:DataContext="{d:DesignInstance Type=viewmodels:CombinedViewModel}"
	mc:Ignorable="d"
	>

	<Window.Resources>
		<converters:ListCountToVisibilityConverter x:Key="ListCountToVisibilityConverter" />
		<converters:FilterIconConverter x:Key="FilterIconConverter" />
	</Window.Resources>

	<Window.DataContext>
		<viewmodels:CombinedViewModel />
	</Window.DataContext>

	<Grid>
		<!--#region Grid size definitions-->
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<Grid.RowDefinitions>
			<RowDefinition Height="30" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<!--#endregion-->

		<!--#region Table selector-->
		<Grid
			Grid.Row="1"
			Grid.Column="0"
			Margin="2"
			>
			<!--#region Grid size definitions-->
			<Grid.RowDefinitions>
				<RowDefinition Height="20" />
				<RowDefinition Height="*" />
				<RowDefinition Height="20" />
			</Grid.RowDefinitions>
			<!--#endregion-->

			<!--#region Header-->
			<TextBlock
				Grid.Row="0"
				Margin="3,0"
				VerticalAlignment="Center"
				FontWeight="Bold"
				Text="Tables"
				/>
			<!--#endregion-->

			<!--#region Datagrid-->
			<syncfusion:SfDataGrid HeaderStyle="{DynamicResource DefaultSfDataGridHeaderStyle}"
				x:Name="tableDataGrid"
				Grid.Row="1"
				Margin="3,5"
				d:ItemsSource="{d:SampleData}"
				AllowDeleting="False"
				AllowEditing="False"
				AllowFiltering="True"
				AllowResizingColumns="True"
				AllowTriStateSorting="True"
				AutoGenerateColumns="False"
				ColumnSizer="Star"
				FilterRowPosition="Top"
				ItemsSource="{Binding TableViewModel.TableList}"
				SelectionMode="Extended"
				ShowSortNumbers="True"
				SortClickAction="DoubleClick"
				Visibility="{Binding TableViewModel.TableList, Converter={StaticResource ListCountToVisibilityConverter}}"
				>
				<syncfusion:SfDataGrid.Columns>
					<syncfusion:GridCheckBoxSelectorColumn
						Width="30"
						AllowFiltering="False"
						AllowSorting="False"
						MappingName="SelectorColumn"
						/>

					<syncfusion:GridTextColumn
						AllowFiltering="True"
						AllowSorting="True"
						HeaderText="Table"
						HorizontalHeaderContentAlignment="Left"
						MappingName="TableName"
						/>

				</syncfusion:SfDataGrid.Columns>
			</syncfusion:SfDataGrid>
			<!--#endregion-->

			<!--#region Alternative textblock when datagrid is empty-->
			<TextBlock
				Grid.Row="1"
				Margin="0,50,0,0"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				FontFamily="CPMono_v07 Bold"
				FontSize="20"
				Foreground="#FFD80A0A"
				RenderTransformOrigin="0.5,0.5"
				TextAlignment="Center"
				Visibility="{Binding TableViewModel.TableList, Converter={StaticResource ListCountToVisibilityConverter}, ConverterParameter=true}"
				>
				<TextBlock.RenderTransform>
					<TransformGroup>
						<ScaleTransform />
						<SkewTransform />
						<RotateTransform Angle="-45" />
						<TranslateTransform />
					</TransformGroup>
				</TextBlock.RenderTransform>
				No<LineBreak />
				tables<LineBreak />
				available</TextBlock>
			<!--#endregion-->

			<!--#region Footer (Status)-->
			<Grid Grid.Row="2">
				<!--#region Grid size definition-->
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="40" />
					<ColumnDefinition Width="AUTO" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.Style>
					<Style TargetType="Grid">
						<Style.Triggers>
							<!--  Hide status row if datagrid is empty  -->
							<DataTrigger Binding="{Binding TableViewModel.TableList.Count}" Value="0">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Grid.Style>
				<!--#endregion-->

				<TextBlock
					Grid.Column="0"
					Margin="4,0"
					VerticalAlignment="Center"
					FontFamily="Consolas"
					FontSize="10"
					Text="Status:"
					/>
				<TextBlock
					Grid.Column="1"
					Margin="2,0"
					VerticalAlignment="Center"
					FontFamily="Consolas"
					FontSize="10"
					FontStyle="Italic"
					FontWeight="Bold"
					Text="{Binding TableViewModel.TableList.Count}"
					/>
				<TextBlock
					Grid.Column="2"
					Margin="4,0"
					VerticalAlignment="Center"
					FontFamily="Consolas"
					FontSize="10"
					Text="Tables available"
					/>
			</Grid>
			<!--#endregion-->
		</Grid>
		<!--#endregion-->

		<!--#region View selector-->
		<Grid
			Grid.Row="1"
			Grid.Column="1"
			Margin="2"
			>
			<!--#region Grid size definitions-->
			<Grid.RowDefinitions>
				<RowDefinition Height="20" />
				<RowDefinition Height="*" />
				<RowDefinition Height="20" />
			</Grid.RowDefinitions>
			<!--#endregion-->

			<!--#region Header-->
			<TextBlock
				Grid.Row="0"
				Grid.Column="0"
				Margin="3,0"
				VerticalAlignment="Center"
				FontWeight="Bold"
				Text="Views"
				/>
			<!--#endregion-->

			<!--#region DataGrid-->
			<syncfusion:SfDataGrid 
				x:Name="viewDataGrid"
				Grid.Row="1"
				Margin="3,5"
				d:ItemsSource="{d:SampleData}"
				AllowDeleting="False"
				AllowEditing="False"
				AllowFiltering="True"
				AllowResizingColumns="True"
				AutoGenerateColumns="False"
				ColumnSizer="Star"
				FilterRowPosition="Top"
				ItemsSource="{Binding TableViewModel.ViewList}"
				SelectionMode="Extended"
				SortClickAction="DoubleClick"
				Visibility="{Binding TableViewModel.ViewList, Converter={StaticResource ListCountToVisibilityConverter}}"
				>
				<syncfusion:SfDataGrid.Columns>
					<syncfusion:GridCheckBoxSelectorColumn
						Width="30"
						AllowFiltering="False"
						AllowSorting="False"
						MappingName="SelectorColumn"
						/>
					<syncfusion:GridTextColumn
						AllowFiltering="True"
						AllowSorting="True"
						HeaderText="View"
						HorizontalHeaderContentAlignment="Left"
						MappingName="TableName"
						/>
				</syncfusion:SfDataGrid.Columns>
				<syncfusion:SfDataGrid.Style>
					<Style TargetType="syncfusion:SfDataGrid">
						<Style.Triggers>
							<!--  Hide datagrid if its empty  -->
							<DataTrigger Binding="{Binding TableViewModel.ViewList.Count}" Value="0">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</syncfusion:SfDataGrid.Style>
			</syncfusion:SfDataGrid>
			<!--#endregion-->

			<!--#region Alternative textblock when datagrid is empty-->
			<TextBlock
				Grid.Row="1"
				Margin="0,50,0,0"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				FontFamily="CPMono_v07 Bold"
				FontSize="20"
				Foreground="#FFD80A0A"
				RenderTransformOrigin="0.5,0.5"
				TextAlignment="Center"
				Visibility="{Binding TableViewModel.ViewList, Converter={StaticResource ListCountToVisibilityConverter}, ConverterParameter=true}"
				>
				<TextBlock.RenderTransform>
					<TransformGroup>
						<ScaleTransform />
						<SkewTransform />
						<RotateTransform Angle="-45" />
						<TranslateTransform />
					</TransformGroup>
				</TextBlock.RenderTransform>
				No<LineBreak />
				views<LineBreak />
				available</TextBlock>
			<!--#endregion-->

			<!--#region Footer (Status)-->
			<Grid Grid.Row="2">
				<!--#region Grid size definition-->
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="40" />
					<ColumnDefinition Width="AUTO" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.Style>
					<Style TargetType="Grid">
						<Style.Triggers>
							<!--  Hide status row if datagrid is empty  -->
							<DataTrigger Binding="{Binding TableViewModel.ViewList.Count}" Value="0">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Grid.Style>
				<!--#endregion-->

				<TextBlock
					Grid.Column="0"
					Margin="4,0"
					VerticalAlignment="Center"
					FontFamily="Consolas"
					FontSize="10"
					Text="Status:"
					/>
				<TextBlock
					Grid.Column="1"
					Margin="2,0"
					VerticalAlignment="Center"
					FontFamily="Consolas"
					FontSize="10"
					FontStyle="Italic"
					FontWeight="Bold"
					Text="{Binding TableViewModel.ViewList.Count}"
					/>
				<TextBlock
					Grid.Column="2"
					Margin="4,0"
					VerticalAlignment="Center"
					FontFamily="Consolas"
					FontSize="10"
					Text="Views available"
					/>
			</Grid>
			<!--#endregion-->
		</Grid>
		<!--#endregion-->

		<!--#region Function selector-->
		<Grid
			Grid.Row="1"
			Grid.Column="2"
			Margin="2"
			>
			<!--#region Grid size definitions-->
			<Grid.RowDefinitions>
				<RowDefinition Height="20" />
				<RowDefinition Height="*" />
				<RowDefinition Height="20" />
			</Grid.RowDefinitions>
			<!--#endregion-->

			<!--#region Header-->
			<TextBlock
				Grid.Row="0"
				Grid.Column="0"
				Margin="3,0"
				VerticalAlignment="Center"
				FontWeight="Bold"
				Text="Functions"
				/>
			<!--#endregion-->

			<!--#region DataGrid-->
			<syncfusion:SfDataGrid
				x:Name="functionDataGrid"
				Grid.Row="1"
				Margin="3,5"
				d:ItemsSource="{d:SampleData}"
				AllowDeleting="False"
				AllowEditing="False"
				AllowFiltering="True"
				AllowResizingColumns="True"
				AutoGenerateColumns="False"
				ColumnSizer="Star"
				FilterRowPosition="Top"
				ItemsSource="{Binding RoutineViewModel.FunctionList}"
				SelectionMode="Extended"
				SortClickAction="DoubleClick"
				Visibility="{Binding RoutineViewModel.FunctionList, Converter={StaticResource ListCountToVisibilityConverter}}"
				>
				<syncfusion:SfDataGrid.Columns>
					<syncfusion:GridCheckBoxSelectorColumn
						Width="30"
						AllowFiltering="False"
						AllowSorting="False"
						MappingName="SelectorColumn"
						/>
					<syncfusion:GridTextColumn
						AllowFiltering="True"
						AllowSorting="True"
						HeaderText="Function"
						HorizontalHeaderContentAlignment="Left"
						MappingName="RoutineName"
						/>
				</syncfusion:SfDataGrid.Columns>
			</syncfusion:SfDataGrid>
			<!--#endregion-->

			<!--#region Alternative textblock when datagrid is empty-->
			<TextBlock
				Grid.Row="1"
				Margin="0,50,0,0"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				FontFamily="CPMono_v07 Bold"
				FontSize="20"
				Foreground="#FFD80A0A"
				LineHeight="14"
				RenderTransformOrigin="0.5,0.5"
				TextAlignment="Center"
				Visibility="{Binding RoutineViewModel.FunctionList, Converter={StaticResource ListCountToVisibilityConverter}, ConverterParameter=true}"
				>
				<TextBlock.RenderTransform>
					<TransformGroup>
						<ScaleTransform />
						<SkewTransform />
						<RotateTransform Angle="-45" />
						<TranslateTransform />
					</TransformGroup>
				</TextBlock.RenderTransform>
				No<LineBreak />
				functions<LineBreak />
				available</TextBlock>
			<!--#endregion-->

			<!--#region Footer (Status)-->
			<Grid Grid.Row="2">
				<!--#region Grid size definition-->
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="40" />
					<ColumnDefinition Width="AUTO" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.Style>
					<Style TargetType="Grid">
						<Style.Triggers>
							<!--  Hide status row if datagrid is empty  -->
							<DataTrigger Binding="{Binding RoutineViewModel.FunctionList.Count}" Value="0">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Grid.Style>
				<!--#endregion-->

				<TextBlock
					Grid.Column="0"
					Margin="4,0"
					VerticalAlignment="Center"
					FontFamily="Consolas"
					FontSize="10"
					Text="Status:"
					/>
				<TextBlock
					Grid.Column="1"
					Margin="2,0"
					VerticalAlignment="Center"
					FontFamily="Consolas"
					FontSize="10"
					FontStyle="Italic"
					FontWeight="Bold"
					Text="{Binding RoutineViewModel.FunctionList.Count}"
					/>
				<TextBlock
					Grid.Column="2"
					Margin="4,0"
					VerticalAlignment="Center"
					FontFamily="Consolas"
					FontSize="10"
					Text="Functions available"
					/>
			</Grid>
			<!--#endregion-->
		</Grid>
		<!--#endregion-->

		<!--#region Stored Procedure selector-->
		<Grid
			Grid.Row="1"
			Grid.Column="30"
			Margin="2"
			>
			<!--#region Grid size definitions-->
			<Grid.RowDefinitions>
				<RowDefinition Height="20" />
				<RowDefinition Height="*" />
				<RowDefinition Height="20" />
			</Grid.RowDefinitions>
			<!--#endregion-->

			<!--#region Header-->
			<TextBlock
				Grid.Row="0"
				Grid.Column="0"
				Margin="3,0"
				VerticalAlignment="Center"
				FontWeight="Bold"
				Text="Stored Procedures"
				/>
			<!--#endregion-->

			<!--#region DataGrid-->
			<syncfusion:SfDataGrid
				x:Name="procedureDataGrid"
				Grid.Row="1"
				Margin="3,5"
				d:ItemsSource="{d:SampleData}"
				AllowDeleting="False"
				AllowEditing="False"
				AllowFiltering="True"
				AllowResizingColumns="True"
				AutoGenerateColumns="False"
				ColumnSizer="Star"
				FilterRowPosition="Top"
				ItemsSource="{Binding RoutineViewModel.ProcedureList}"
				SelectionMode="Extended"
				SortClickAction="DoubleClick"
				Visibility="{Binding RoutineViewModel.ProcedureList, Converter={StaticResource ListCountToVisibilityConverter}}"
				>
				<syncfusion:SfDataGrid.Columns>
					<syncfusion:GridCheckBoxSelectorColumn
						Width="30"
						AllowFiltering="False"
						AllowSorting="False"
						MappingName="SelectorColumn"
						/>
					<syncfusion:GridTextColumn
						AllowFiltering="True"
						AllowSorting="True"
						HeaderText="Stored Procedure"
						HorizontalHeaderContentAlignment="Left"
						MappingName="RoutineName"
						/>
				</syncfusion:SfDataGrid.Columns>
				<syncfusion:SfDataGrid.Style>
					<Style TargetType="syncfusion:SfDataGrid">
						<Style.Triggers>
							<!--  Hide datagrid if its empty  -->
							<DataTrigger Binding="{Binding TableViewModel.ProcedurenList.Count}" Value="0">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</syncfusion:SfDataGrid.Style>
			</syncfusion:SfDataGrid>
			<!--#endregion-->

			<!--#region Alternative textblock when datagrid is empty-->
			<TextBlock
				Grid.Row="1"
				Margin="0,50,0,0"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				FontFamily="CPMono_v07 Bold"
				FontSize="20"
				Foreground="#FFD80A0A"
				RenderTransformOrigin="0.5,0.5"
				TextAlignment="Center"
				Visibility="{Binding RoutineViewModel.ProcedureList, Converter={StaticResource ListCountToVisibilityConverter}, ConverterParameter=true}"
				>
				<TextBlock.RenderTransform>
					<TransformGroup>
						<ScaleTransform />
						<SkewTransform />
						<RotateTransform Angle="-45" />
						<TranslateTransform />
					</TransformGroup>
				</TextBlock.RenderTransform>
				No<LineBreak />
				stored procedures<LineBreak />
				available</TextBlock>
			<!--#endregion-->

			<!--#region Footer (Status)-->
			<Grid Grid.Row="2">
				<!--#region Grid size definition-->
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="40" />
					<ColumnDefinition Width="AUTO" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.Style>
					<Style TargetType="Grid">
						<Style.Triggers>
							<!--  Hide status row if datagrid is empty  -->
							<DataTrigger Binding="{Binding RoutineViewModel.ProcedureList.Count}" Value="0">
								<Setter Property="Visibility" Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Grid.Style>
				<!--#endregion-->

				<TextBlock
					Grid.Column="0"
					Margin="4,0"
					VerticalAlignment="Center"
					FontFamily="Consolas"
					FontSize="10"
					Text="Status:"
					/>
				<TextBlock
					Grid.Column="1"
					Margin="2,0"
					VerticalAlignment="Center"
					FontFamily="Consolas"
					FontSize="10"
					FontStyle="Italic"
					FontWeight="Bold"
					Text="{Binding RoutineViewModel.ProcedureList.Count}"
					/>
				<TextBlock
					Grid.Column="2"
					Margin="4,0"
					VerticalAlignment="Center"
					FontFamily="Consolas"
					FontSize="10"
					Text="Procedures available"
					/>
			</Grid>
			<!--#endregion-->
		</Grid>
		<!--#endregion-->

	</Grid>
</Window>
